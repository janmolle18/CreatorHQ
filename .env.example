# ── CreatorHQ Umgebungsvariablen ────────────────────────────────────────────────
# Kopieren nach .env und ausfüllen. Niemals .env committen.
# Host-Ports sind verschoben (5435/6381/9004), damit CreatorHQ parallel zu
# DavidHQ laufen kann. Alle Ports binden nur an 127.0.0.1.

# ── Nur für den Produktionsbetrieb (docker-compose.prod.yml) ──────────────
# Die Domain, auf die dein A-Eintrag zeigt — ohne https://. Caddy beantragt
# dafür das Zertifikat. Siehe docs/betrieb.md.
DOMAIN=

# Docker Compose (Infrastruktur-Container)
# POSTGRES_USER ist Superuser: Eigentümer der Tabellen, führt Migrationen und
# die nächtliche Sicherung aus. Superuser umgehen Row Level Security immer —
# deshalb verbindet die Anwendung NICHT als dieser Nutzer.
POSTGRES_USER=creatorhq
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=creatorhq
MINIO_ROOT_USER=creatorhq
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Rolle der Anwendung: darf Daten lesen und schreiben, kein DDL, KEIN Superuser
# und damit den Mandantenregeln unterworfen. Wird beim ersten Start des leeren
# Postgres-Datenverzeichnisses von db/init/01-app-role.sh angelegt.
APP_DB_USER=creatorhq_app
APP_DB_PASSWORD=CHANGE_ME_ANOTHER_STRONG_PASSWORD

# App-Sicht auf die Infrastruktur (Host-Perspektive; in Containern werden diese
# URLs später per Compose-Override auf die Service-Namen gesetzt)
# DATABASE_URL nutzt die eingeschränkte Rolle — hier greift RLS.
DATABASE_URL=postgres://creatorhq_app:CHANGE_ME_ANOTHER_STRONG_PASSWORD@localhost:5435/creatorhq
# MIGRATION_DATABASE_URL nutzt den Eigentümer — nur für drizzle-kit und Backup.
MIGRATION_DATABASE_URL=postgres://creatorhq:CHANGE_ME_STRONG_PASSWORD@localhost:5435/creatorhq
REDIS_URL=redis://localhost:6381
# Verbindungspool. Der Worker braucht mehr als das Web: Lang laufende Aufträge
# (Download, Rendern, Upload) belegen für ihre Dauer je eine Verbindung, und der
# Minuten-Takt braucht daneben eine freie — sonst wartet der Takt auf eine
# Verbindung, die ein Auftrag hält, der auf den Takt wartet.
DB_POOL_MAX=20
S3_ENDPOINT=http://localhost:9004
S3_ACCESS_KEY=creatorhq
S3_SECRET_KEY=CHANGE_ME_STRONG_PASSWORD
S3_BUCKET=creatorhq
TZ=Europe/Berlin

# App-Sicherheit
# Hash erzeugen: node scripts/hash-password.mjs "dein-passwort"
ADMIN_PASSWORD_HASH=
# 32-Byte-Hex, erzeugen: openssl rand -hex 32
APP_ENCRYPTION_KEY=
SESSION_SECRET=
# Öffentliche Basis-URL (benannter Cloudflare Tunnel mit fester Domain, KEIN trycloudflare-Quick-Tunnel)
APP_BASE_URL=http://localhost:3001
# Öffentlicher HTTPS-Origin für Instagram-video_url (Tunnel auf die Web-App).
# Leer/localhost = Instagram-Publishing fällt sauber auf Manuell zurück.
PUBLIC_MEDIA_BASE_URL=

# Claude API (Captions + Daily Briefing)
ANTHROPIC_API_KEY=
CAPTION_MODEL=claude-haiku-4-5-20251001
BRIEFING_MODEL=claude-sonnet-5

# ── Freigabe-Schalter je Plattform ────────────────────────────────────────
# Auf true stellen, SOBALD die Plattform die App freigegeben hat. Vorher darf
# sich nur verbinden, wer dort ausdruecklich als Test-Nutzer/Tester eingetragen
# ist — die Oberflaeche sagt das dem Creator dann auch so, statt einen Knopf
# anzubieten, der in einer Fehlermeldung endet. Bewusst ein Handgriff und keine
# Vermutung: Eine falsch geratene Freigabe schickt Kunden in eine Sackgasse,
# die nach ihrem Fehler aussieht.
GOOGLE_APP_LIVE=false
TIKTOK_APP_LIVE=false
IG_APP_LIVE=false

# YouTube (Quelle: Discovery + Kommentare per API-Key; Publishing/Analytics per OAuth)
YOUTUBE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/oauth/google/callback
# private bis YouTube-API-Audit bestanden, danach public
YT_UPLOAD_PRIVACY=private

# TikTok (Content Posting API v2) — eine App für alle Mandanten
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
# false = Draft-Inbox-Modus (ohne App-Audit), true = Direct Post (nach Audit)
TIKTOK_DIRECT_POST=false

# Instagram ("Instagram API with Instagram Login") — eine App für alle Mandanten
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=

# Twitch (nur Quelle/Discovery für Streamer-Mandanten)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Worker-Pfade (Defaults passen für Host-Dev UND Docker; nur bei Bedarf setzen)
# TMP_DIR=/eigener/tmp-pfad
# COOKIES_PATH=/pfad/zu/cookies.txt
# YTDLP_PATH=yt-dlp

# Pipeline
# smart = Transkript-basierte Auswahl (satzgenaue Grenzen, Kontext; Claude wenn Key da,
# sonst Satz-Heuristik). ffmpeg = alter Lautstärke-Provider mit festen Fenstern.
CLIP_PROVIDER=smart
CLIP_LENGTH_SECONDS=62
CLIP_MAX_SECONDS=90
MAX_CLIP_CANDIDATES=8
# CLIP_MODEL=claude-sonnet-5
# small = Standard (passt in die übliche ~4-GB-Docker-VM). large-v3-turbo = beste
# Deutsch-Qualität, braucht aber ≥ 8 GB VM-RAM (Docker Desktop → Resources → Memory).
WHISPER_MODEL=small
WHISPER_LANGUAGE=de
SUBTITLES_ENABLED=true
DISCOVERY_CRON=0 6 * * *
AUTO_DISCOVERY_ENABLED=false
