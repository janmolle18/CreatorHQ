{
  "name": "creatorhq",
  "version": "0.1.0",
  "private": true,
  "description": "CreatorHQ — Clip-Pipeline, Multi-Plattform-Publishing, Analytics, KI-Briefing und Content-Planung fuer mehrere Creator",
  "workspaces": [
    "db",
    "shared",
    "worker",
    "web"
  ],
  "scripts": {
    "check": "npm run typecheck --workspaces --if-present && vitest run",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run -w @creatorhq/db generate",
    "db:migrate": "npm run -w @creatorhq/db migrate",
    "db:studio": "npm run -w @creatorhq/db studio",
    "web:dev": "npm run -w @creatorhq/web dev",
    "web:build": "npm run -w @creatorhq/web build",
    "web:start": "npm run -w @creatorhq/web start",
    "worker:dev": "npm run -w @creatorhq/worker dev",
    "up": "docker compose up -d",
    "down": "docker compose down",
    "logs": "docker compose logs -f",
    "setup": "./scripts/setup-local.sh",
    "testdb": "./scripts/test-db.sh test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
